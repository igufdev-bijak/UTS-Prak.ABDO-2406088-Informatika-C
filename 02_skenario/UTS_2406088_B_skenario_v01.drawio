<mxCell id="gen8" value="Pasien memperoleh pendaftaran berobat pada slot jadwal dokter yang tersedia." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="480" height="44" as="geometry"/></mxCell>
