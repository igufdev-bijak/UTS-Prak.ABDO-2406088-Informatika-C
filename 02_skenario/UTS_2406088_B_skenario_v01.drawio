<mxCell id="gen34" value="10. Sistem menolak penyimpanan dan menampilkan pesan jadwal tidak tersedia; tidak ada pendaftaran tersimpan." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="810" width="480" height="48" as="geometry"/></mxCell>
<mxCell id="gen35" value="11. Pasien memilih membayar administrasi (cabang dari langkah 8; condition [status Menunggu Pembayaran dan pasien memilih membayar]; extension point Pendaftaran tercatat)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="858" width="420" height="66" as="geometry"/></mxCell>
<mxCell id="gen36" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="858" width="480" height="66" as="geometry"/></mxCell>
<mxCell id="gen37" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="924" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="gen38" value="12. Sistem mencatat pembayaran administrasi dan mengubah status pendaftaran menjadi Terdaftar." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="924" width="480" height="48" as="geometry"/></mxCell>
<mxCell id="gen39" value="13. Pasien memilih membatalkan pendaftaran (cabang dari langkah 8; condition [status Menunggu Pembayaran dan pasien memilih membatalkan]; extension point Pendaftaran tercatat)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="972" width="420" height="66" as="geometry"/></mxCell>
<mxCell id="gen40" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="972" width="480" height="66" as="geometry"/></mxCell>
<mxCell id="gen41" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="1038" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="gen42" value="14. Sistem mengubah status pendaftaran menjadi Dibatalkan." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="1038" width="480" height="48" as="geometry"/></mxCell>
<mxCell id="gen43" value="Skenario Akhir" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#F2F2F2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="1086" width="420" height="84" as="geometry"/></mxCell>
<mxCell id="gen44" value="Use case selesai jika pendaftaran tersimpan dengan status Menunggu Pembayaran; status menjadi Terdaftar jika Pasien membayar, atau Dibatalkan jika Pasien membatalkan; jika jadwal tidak tersedia, tidak ada pendaftaran yang tersimpan." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="1086" width="480" height="84" as="geometry"/></mxCell>
<mxCell id="gen45" value="Keterangan:&lt;br&gt;- Include: UC02 Daftar Berobat → UC03 Periksa Ketersediaan Jadwal (wajib, dijalankan sebelum penyimpanan).&lt;br&gt;- Extend: UC04 Bayar Administrasi → UC02; condition [status Menunggu Pembayaran dan pasien memilih membayar administrasi]; extension point Pendaftaran tercatat.&lt;br&gt;- Extend: UC05 Batalkan Pendaftaran → UC02; condition [status Menunggu Pembayaran dan pasien memilih membatalkan pendaftaran]; extension point Pendaftaran tercatat.&lt;br&gt;- Langkah 11–14 adalah perilaku extend, bukan langkah wajib UC02.&lt;br&gt;- Asumsi: status pendaftaran adalah Menunggu Pembayaran, Terdaftar, atau Dibatalkan; pembayaran dan pembatalan hanya berlaku untuk pendaftaran berstatus Menunggu Pembayaran." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="1188" width="900" height="178" as="geometry"/></mxCell>
