<mxCell id="gen29" value="8. Sistem menampilkan nomor pendaftaran, status, dan pilihan tindakan lanjutan." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="686" width="480" height="48" as="geometry"/></mxCell>
