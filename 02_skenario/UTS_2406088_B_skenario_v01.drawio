<mxCell id="gen31" value="9. Slot jadwal tidak tersedia saat pemeriksaan (cabang dari langkah 6)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="762" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="gen32" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="762" width="480" height="48" as="geometry"/></mxCell>
